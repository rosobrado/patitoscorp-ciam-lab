@page "/Cuenta"
@model DocumentosModel
@{
    ViewData["Title"] = "Mi cuenta";
    var user = HttpContext.Items["user"] as CiamLabApp.SiteUser;
    var isAuth = user != null;
    var accountsJson = System.Text.Json.JsonSerializer.Serialize(Model.Accounts);
    var txJson = System.Text.Json.JsonSerializer.Serialize(Model.Transactions);
    string Initials(string? n) => string.Concat((n ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
}

@if (!isAuth)
{
    <section class="max-w-3xl mx-auto px-6 py-24 text-center">
        <div class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-3xl bg-gradient-to-br from-brand-600 via-pink-500 to-duck-500 shadow-glow">
            <svg class="h-8 w-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h1 class="mt-6 font-display text-4xl font-extrabold">Acceso restringido</h1>
        <p class="mt-4 text-slate-600 max-w-xl mx-auto">Tu banca digital está protegida con autenticación moderna. Iniciá sesión para ver tu saldo y movimientos.</p>
        <a href="/Account/Login?returnUrl=/Cuenta" class="mt-8 inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-slate-900 text-white font-semibold shadow-glow hover:bg-brand-700 transition">
            Iniciar sesión
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </section>
}
else
{
    <!-- Hosted-banking shell: sidebar + content -->
    <div class="max-w-7xl mx-auto px-4 lg:px-8 py-8">
      <div class="rounded-[28px] bg-white shadow-soft border border-slate-200/60 overflow-hidden">

        <!-- App top bar -->
        <div class="flex items-center justify-between px-6 lg:px-8 h-16 border-b border-slate-100 bg-white">
            <div class="flex items-center gap-2.5">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-brand-600 via-pink-500 to-duck-500">
                    <svg viewBox="0 0 64 64" class="h-5 w-5 text-white" fill="currentColor"><path d="M44 18a8 8 0 1 0-7.6 8H40a4 4 0 0 1 4 4v2H22c-7 0-12 5-12 12 0 5 4 9 9 9h24c8 0 14-6 14-14V26c0-4-3-7-7-7h-6v-1z"/></svg>
                </span>
                <span class="font-display font-extrabold tracking-tight">PatitosBank</span>
            </div>
            <div class="flex items-center gap-3">
                <button class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-50 border border-slate-200 hover:bg-slate-100 transition text-sm">
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-gradient-to-br from-brand-500 to-duck-500 text-white text-[10px] font-bold">@Initials(user!.DisplayName)</span>
                    <span class="font-semibold text-slate-800 max-w-[120px] truncate">@user!.DisplayName</span>
                    <svg class="h-3.5 w-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <button class="relative inline-flex items-center justify-center h-9 w-9 rounded-full hover:bg-slate-100 transition" aria-label="Mensajes">
                    <svg class="h-5 w-5 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v14H6l-2 2z"/></svg>
                    <span class="absolute -top-0.5 -right-0.5 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-pink-500 text-white text-[10px] font-bold px-1">2</span>
                </button>
                <button class="inline-flex items-center justify-center h-9 w-9 rounded-full hover:bg-slate-100 transition" aria-label="Alertas">
                    <svg class="h-5 w-5 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5h10l-3 4 3 4H11"/><line x1="11" y1="3" x2="11" y2="22"/></svg>
                </button>
                <a href="/Account/Logout" class="inline-flex items-center justify-center h-9 w-9 rounded-full hover:bg-slate-100 transition" aria-label="Cerrar sesión" title="Cerrar sesión">
                    <svg class="h-5 w-5 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-12 min-h-[720px]">
            <!-- Sidebar -->
            <aside class="hidden md:flex md:col-span-3 lg:col-span-2 flex-col gap-1 p-4 bg-brand-50/40 border-r border-slate-100">
                <a href="#" class="flex items-center justify-between gap-2 px-3 py-2.5 rounded-xl bg-white shadow-soft border border-slate-200 text-sm font-bold text-slate-900">
                    <span class="flex items-center gap-2">
                        <svg class="h-4 w-4 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
                        Resumen
                    </span>
                    <span class="inline-flex h-4 w-4 items-center justify-center rounded-md bg-brand-600 text-white">
                        <svg class="h-2.5 w-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                </a>
                <a href="#cuentas" class="flex items-center gap-2 px-3 py-2.5 rounded-xl hover:bg-white/60 transition text-sm font-medium text-slate-600">
                    <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                    Cuentas
                </a>
                <a href="#movimientos" class="flex items-center gap-2 px-3 py-2.5 rounded-xl hover:bg-white/60 transition text-sm font-medium text-slate-600">
                    <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                    Pagos
                </a>
                <a href="#" class="flex items-center gap-2 px-3 py-2.5 rounded-xl hover:bg-white/60 transition text-sm font-medium text-slate-600">
                    <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><line x1="2" y1="11" x2="22" y2="11"/></svg>
                    Tarjetas
                </a>
                <a href="#" class="flex items-center gap-2 px-3 py-2.5 rounded-xl hover:bg-white/60 transition text-sm font-medium text-slate-600">
                    <svg class="h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.65 1.65 0 0 0 15 19.4a1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09A1.65 1.65 0 0 0 15 4.6a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.14.34.22.71.22 1.09V11a2 2 0 0 1-2 2h-.09c-.38 0-.75.08-1.09.22z"/></svg>
                    Ajustes
                </a>
                <div class="mt-auto pt-6 px-3 text-[11px] text-slate-500">
                    <p class="font-bold uppercase tracking-wider mb-1">Demo</p>
                    @if (Model.Seeded)
                    {
                        <a href="/Cuenta?reset=1" class="text-brand-700 hover:underline">Vaciar datos</a>
                    }
                    else
                    {
                        <a href="/Cuenta?seed=1" class="text-brand-700 hover:underline">Cargar datos demo</a>
                    }
                </div>
            </aside>

            <!-- Content -->
            <section class="col-span-12 md:col-span-9 lg:col-span-10 p-6 lg:p-10 bg-white">
                <div id="dashboard"
                     data-name="@user!.DisplayName"
                     data-email="@user.Email"
                     data-idp="@user.IdentityProvider"
                     data-seeded="@(Model.Seeded ? "1" : "0")"
                     data-accounts="@Html.Raw(System.Net.WebUtility.HtmlEncode(accountsJson))"
                     data-tx="@Html.Raw(System.Net.WebUtility.HtmlEncode(txJson))"></div>
            </section>
        </div>
      </div>
    </div>
}

@if (isAuth)
{
<script type="module">
import { createRoot } from 'react-dom/client';
import { createElement, useState, useMemo } from 'react';
import htm from 'htm';
const html = htm.bind(createElement);

const root = document.getElementById('dashboard');
const data = {
    name:    root.dataset.name,
    email:   root.dataset.email,
    idp:     root.dataset.idp,
    seeded:  root.dataset.seeded === '1',
    accounts: JSON.parse(root.dataset.accounts),
    tx:       JSON.parse(root.dataset.tx)
};

const fmt = (n, c) => new Intl.NumberFormat(c === 'USD' ? 'en-US' : 'es-CR', { style: 'currency', currency: c, minimumFractionDigits: 2 }).format(n);
const FLAG_CR = html`<span class="inline-block h-4 w-5 rounded-sm overflow-hidden shadow-sm">
    <span class="block h-1 bg-blue-700"></span><span class="block h-1 bg-white"></span><span class="block h-2 bg-red-600"></span><span class="block h-1 bg-white"></span><span class="block h-1 bg-blue-700"></span>
</span>`;
const FLAG_US = html`<span class="inline-block h-4 w-5 rounded-sm bg-red-600 relative overflow-hidden shadow-sm">
    <span class="absolute inset-x-0 top-0 h-2 w-2 bg-blue-700"></span>
</span>`;

function AccountIcon({ currency }) {
    return html`<span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white border border-slate-200">
        ${currency === 'USD' ? FLAG_US : FLAG_CR}
    </span>`;
}

function Header() {
    const total = data.accounts
        .filter(a => a.Currency === 'CRC')
        .reduce((s, a) => s + a.Balance, 0);
    return html`<div class="mb-7">
        <p class="text-sm text-slate-500">Saldo total disponible</p>
        <button class="mt-1 inline-flex items-center gap-2 font-display text-4xl lg:text-[42px] font-extrabold text-slate-900 hover:text-brand-700 transition">
            <span class="tabular-nums">${fmt(total, 'CRC')}</span>
            <svg class="h-5 w-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
    </div>`;
}

function QuickAction({ icon, label, color, badge }) {
    return html`<button class="group relative flex items-center gap-3 p-4 rounded-2xl bg-slate-50 hover:bg-white hover:shadow-soft border border-transparent hover:border-slate-200 transition text-left w-full">
        <span class=${"relative inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-white shadow-soft " + color}>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${icon}</svg>
            ${badge ? html`<span class="absolute -top-1 -right-1 inline-flex h-5 min-w-[20px] items-center justify-center rounded-full bg-pink-500 text-white text-[10px] font-bold px-1">${badge}</span>` : null}
        </span>
        <span class="font-semibold text-slate-800">${label}</span>
    </button>`;
}

function QuickActions() {
    return html`<div class="grid sm:grid-cols-3 gap-3 mb-9">
        <${QuickAction} label="Nuevo pago" color="bg-brand-600"
            icon=${html`<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>`} />
        <${QuickAction} label="Cambio de divisas" color="bg-sky-500"
            icon=${html`<path d="M17 3l4 4-4 4"/><path d="M3 7h18"/><path d="M7 21l-4-4 4-4"/><path d="M21 17H3"/>`} />
        <${QuickAction} label="Pagos por firmar" color="bg-slate-700" badge=${data.seeded ? 12 : 0}
            icon=${html`<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 15l2 2 4-4"/>`} />
    </div>`;
}

function AccountCard({ a }) {
    const [hidden, setHidden] = useState(false);
    return html`<div class="group flex items-center gap-3 p-3 rounded-2xl bg-slate-50 hover:bg-white hover:shadow-soft border border-transparent hover:border-slate-200 transition">
        <${AccountIcon} currency=${a.Currency} />
        <div class="min-w-0 flex-1">
            <div class="font-bold text-slate-900 tabular-nums">
                ${hidden ? '••••••' : fmt(a.Balance, a.Currency)}
            </div>
            <div class="text-xs text-slate-500 truncate">${a.Name} ··${a.Number.slice(-4)}</div>
        </div>
        <button onClick=${() => setHidden(h => !h)} class="opacity-0 group-hover:opacity-100 inline-flex h-7 w-7 items-center justify-center rounded-full hover:bg-slate-100 transition" aria-label="Ocultar saldo">
            <svg class="h-3.5 w-3.5 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        </button>
    </div>`;
}

function Accounts() {
    if (!data.seeded) {
        return html`<div class="mb-10">
            <div class="flex items-center justify-between mb-4">
                <h2 class="font-display text-xl font-extrabold">Mis cuentas</h2>
            </div>
            <div class="rounded-2xl border border-dashed border-slate-300 p-8 text-center bg-slate-50/60">
                <div class="mx-auto h-12 w-12 rounded-2xl bg-white border border-slate-200 flex items-center justify-center mb-3">
                    <svg class="h-6 w-6 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                </div>
                <h3 class="font-display font-bold text-slate-900">Tu Cuenta Pato está activa 🦆</h3>
                <p class="mt-1 text-sm text-slate-600">Aún no tenés movimientos. Cargá saldo o activá los datos demo.</p>
                <div class="mt-4 flex flex-wrap gap-2 justify-center">
                    <a href="#" class="px-4 py-2 rounded-full bg-brand-600 text-white text-sm font-semibold hover:bg-brand-700 transition">Cargar mi cuenta</a>
                    <a href="/Cuenta?seed=1" class="px-4 py-2 rounded-full bg-duck-400 text-slate-900 text-sm font-semibold hover:bg-duck-500 transition">🧪 Activar datos demo</a>
                </div>
            </div>
        </div>`;
    }
    return html`<div class="mb-10" id="cuentas">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-display text-xl font-extrabold">Mis cuentas</h2>
            <a href="#" class="text-sm font-semibold text-brand-700 hover:underline inline-flex items-center gap-1">Ver todas <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></a>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            ${data.accounts.map((a, i) => html`<${AccountCard} key=${i} a=${a} />`)}
        </div>
    </div>`;
}

function TxAvatar({ name }) {
    const colors = ['from-brand-500 to-pink-500','from-sky-500 to-indigo-500','from-emerald-500 to-teal-500','from-duck-500 to-orange-500','from-slate-700 to-slate-900','from-pink-500 to-rose-500'];
    const initials = name.split(' ').slice(0, 2).map(s => s[0]).join('').toUpperCase();
    const idx = name.charCodeAt(0) % colors.length;
    return html`<span class=${"inline-flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br text-white text-sm font-bold shadow-soft " + colors[idx]}>${initials}</span>`;
}

function PaymentTemplates() {
    if (!data.seeded) return null;
    // pull recent unique payees from tx
    const seen = new Set();
    const templates = data.tx
        .map(t => {
            const m = t.Description.match(/—\s*(.+)/) || t.Description.match(/-\s*(.+)/);
            const payee = m ? m[1].trim() : t.Description;
            return { payee, amount: t.Amount, currency: t.Currency };
        })
        .filter(t => { if (seen.has(t.payee)) return false; seen.add(t.payee); return true; })
        .slice(0, 6);
    return html`<div class="mb-4">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-display text-xl font-extrabold">Plantillas de pago</h2>
            <a href="#" class="text-sm font-semibold text-brand-700 hover:underline inline-flex items-center gap-1">Ver todas <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></a>
        </div>
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-4">
            ${templates.map((t, i) => html`<button key=${i} class="flex flex-col items-center text-center gap-2 group">
                <${TxAvatar} name=${t.payee} />
                <span class="text-xs font-semibold text-slate-800 line-clamp-2 group-hover:text-brand-700 transition">${t.payee}</span>
                <span class="text-[11px] text-slate-500 tabular-nums">${fmt(Math.abs(t.amount), t.currency)}</span>
            </button>`)}
        </div>
    </div>`;
}

function Transactions() {
    if (!data.seeded || data.tx.length === 0) return null;
    return html`<div class="mt-10" id="movimientos">
        <div class="flex items-center justify-between mb-4">
            <h2 class="font-display text-xl font-extrabold">Movimientos recientes</h2>
            <a href="#" class="text-sm font-semibold text-brand-700 hover:underline inline-flex items-center gap-1">Ver todos <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></a>
        </div>
        <div class="rounded-2xl border border-slate-200 overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider">
                    <tr><th class="text-left px-4 py-3 font-semibold">Fecha</th><th class="text-left px-4 py-3 font-semibold">Descripción</th><th class="text-left px-4 py-3 font-semibold">Categoría</th><th class="text-right px-4 py-3 font-semibold">Monto</th></tr>
                </thead>
                <tbody>
                    ${data.tx.map((t, i) => html`<tr key=${i} class="border-t border-slate-100 hover:bg-slate-50 transition">
                        <td class="px-4 py-3 text-slate-500 tabular-nums">${t.Date}</td>
                        <td class="px-4 py-3 font-medium text-slate-800">${t.Description}</td>
                        <td class="px-4 py-3"><span class="inline-flex items-center px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 text-[11px] font-semibold">${t.Category}</span></td>
                        <td class=${"px-4 py-3 text-right tabular-nums font-bold " + (t.Amount < 0 ? 'text-slate-900' : 'text-emerald-600')}>${(t.Amount < 0 ? '−' : '+')}${fmt(Math.abs(t.Amount), t.Currency)}</td>
                    </tr>`)}
                </tbody>
            </table>
        </div>
    </div>`;
}

function ProfileFooter() {
    const [devMode, setDevMode] = useState(false);
    return html`<div class="mt-10 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-slate-500">
        <div class="flex items-center gap-2">
            <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
            <span>Sesión verificada por <span class="font-semibold text-slate-700">Microsoft Entra External ID</span> · ${data.email || '—'}</span>
        </div>
        <label class="inline-flex items-center gap-2 cursor-pointer select-none">
            <span>Modo desarrollador</span>
            <input type="checkbox" class="sr-only" checked=${devMode} onChange=${e => setDevMode(e.target.checked)} />
            <span class=${"relative inline-block h-5 w-9 rounded-full transition " + (devMode ? 'bg-brand-600' : 'bg-slate-300')}>
                <span class=${"absolute top-0.5 h-4 w-4 rounded-full bg-white shadow transition-transform " + (devMode ? 'translate-x-[18px]' : 'translate-x-0.5')}></span>
            </span>
        </label>
        ${devMode ? html`<a href="#" onClick=${e => { e.preventDefault(); alert('IdP: ' + (data.idp || 'unknown') + '\nEmail: ' + data.email + '\nSeeded: ' + data.seeded); }} class="text-brand-700 hover:underline">Ver claims del token</a>` : null}
    </div>`;
}

function App() {
    return html`<div>
        <${Header} />
        <${QuickActions} />
        <${Accounts} />
        <${PaymentTemplates} />
        <${Transactions} />
        <${ProfileFooter} />
    </div>`;
}

createRoot(root).render(html`<${App} />`);
</script>
}