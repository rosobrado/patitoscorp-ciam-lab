@page
@model BienvenidoModel
@{
    ViewData["Title"] = "Verifica tu identidad";
    var user = HttpContext.Items["user"] as CiamLabApp.SiteUser;
    var next = Model.Next;
}

<section class="max-w-3xl mx-auto px-6 py-16">
    <div class="text-xs text-slate-500 mb-3"><a href="/" class="hover:text-brand-600">Inicio</a> <span class="mx-1">&rsaquo;</span> <span>Verifica tu identidad</span></div>
    <h1 class="font-display text-4xl font-extrabold tracking-tight">&iexcl;Hola, @user?.DisplayName! ðŸ¦†</h1>
    <p class="mt-3 text-slate-600 leading-relaxed">
        Tu identidad digital qued&oacute; verificada con Microsoft Entra External ID. Falta un &uacute;ltimo paso para activar tu cuenta en Patitos Bank: confirmar tus datos personales para cumplir con la regulaci&oacute;n <strong>Conozca a su Cliente (KYC)</strong>.
    </p>

    <ol class="mt-8 grid sm:grid-cols-3 gap-3">
        <li class="rounded-2xl border border-emerald-200 bg-emerald-50 p-4">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-emerald-700">
                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-emerald-600 text-white text-[10px]">&#10003;</span>
                Paso 1
            </div>
            <div class="mt-2 font-semibold text-slate-900">Identidad digital</div>
            <p class="text-xs text-slate-600 mt-1">Verificada con External ID</p>
        </li>
        <li class="rounded-2xl border-2 border-brand-400 bg-brand-50 p-4 shadow-soft">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-brand-700">
                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-brand-600 text-white text-[10px]">2</span>
                Paso 2 &middot; Activo
            </div>
            <div class="mt-2 font-semibold text-slate-900">Datos personales</div>
            <p class="text-xs text-slate-600 mt-1">Confirma tu informaci&oacute;n KYC</p>
        </li>
        <li class="rounded-2xl border border-slate-200 bg-white/60 p-4">
            <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
                <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-slate-300 text-white text-[10px]">3</span>
                Paso 3
            </div>
            <div class="mt-2 font-semibold text-slate-900">Cuenta activa</div>
            <p class="text-xs text-slate-600 mt-1">Empieza a operar</p>
        </li>
    </ol>

    <form method="post" class="mt-8 rounded-3xl bg-white/85 backdrop-blur border border-slate-200 p-6 shadow-soft space-y-5">
        <input type="hidden" name="next" value="@next" />
        <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
                <span class="text-xs font-semibold text-slate-600">C&eacute;dula</span>
                <input name="cedula" type="text" placeholder="1-2345-6789" autocomplete="off"
                    class="mt-1 w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200" />
            </label>
            <label class="block">
                <span class="text-xs font-semibold text-slate-600">Fecha de nacimiento</span>
                <input name="dob" type="date"
                    class="mt-1 w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200" />
            </label>
            <label class="block sm:col-span-2">
                <span class="text-xs font-semibold text-slate-600">Direcci&oacute;n</span>
                <input name="address" type="text" placeholder="San Jos&eacute;, Costa Rica" autocomplete="off"
                    class="mt-1 w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200" />
            </label>
            <label class="block sm:col-span-2">
                <span class="text-xs font-semibold text-slate-600">Ocupaci&oacute;n</span>
                <select name="occupation"
                    class="mt-1 w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-white focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200">
                    <option>Empleado/a</option>
                    <option>Profesional independiente</option>
                    <option>Estudiante</option>
                    <option>Emprendedor/a</option>
                    <option>Otro</option>
                </select>
            </label>
        </div>
        <label class="flex items-start gap-2 text-sm text-slate-600">
            <input type="checkbox" name="tos" class="mt-1 h-4 w-4 rounded border-slate-300 text-brand-600" />
            <span>Acepto los <a href="#" class="text-brand-700 underline">T&eacute;rminos</a> y la <a href="#" class="text-brand-700 underline">Pol&iacute;tica de Privacidad</a> de Patitos Bank.</span>
        </label>
        <div class="rounded-xl bg-slate-50 border border-slate-200 p-4 text-xs text-slate-600 flex items-start gap-2">
            <span class="text-base">ðŸ§ª</span>
            <span><strong>Modo demo:</strong> Este formulario es ilustrativo. No se guarda ning&uacute;n dato &mdash; al continuar solo se setea una cookie local <code class="font-mono">pb_kyc_done</code> para no volver a mostrarte este paso. La verificaci&oacute;n KYC real se conectar&iacute;a aqu&iacute; a un proveedor como Onfido, Sumsub o Truora.</span>
        </div>
        <div class="flex flex-wrap items-center gap-3 justify-between">
            <a href="/" class="text-sm text-slate-500 hover:text-slate-700">&larr; Volver al inicio</a>
            <div class="flex gap-3">
                <button type="submit" name="skip" value="1" class="px-5 py-3 rounded-full bg-white border border-slate-300 font-semibold text-slate-700 hover:border-brand-400 transition">Saltar (demo)</button>
                <button type="submit" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-900 text-white font-semibold shadow-glow hover:bg-brand-700 transition">
                    Activar mi cuenta
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
            </div>
        </div>
    </form>
</section>