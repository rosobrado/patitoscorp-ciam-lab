@using Microsoft.Extensions.Options
@inject IOptions<CiamLabApp.BrandingOptions> BrandOpt
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpCtx
@{
    var brand = BrandOpt.Value;
    var user = HttpCtx.HttpContext?.Items["user"] as CiamLabApp.SiteUser;
    var isAuth = user != null;
    var path = HttpCtx.HttpContext?.Request.Path.Value ?? "/";
    string Initials(string? n) => string.Concat((n ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
}
<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @brand.FullName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@300;400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@@500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        display: ['"Plus Jakarta Sans"', 'Inter', 'system-ui', 'sans-serif']
                    },
                    colors: {
                        brand: { 50:'#f5f3ff',100:'#ede9fe',200:'#ddd6fe',300:'#c4b5fd',400:'#a78bfa',500:'#8b5cf6',600:'#7c3aed',700:'#6d28d9',800:'#5b21b6',900:'#4c1d95' },
                        duck:  { 300:'#fde68a',400:'#fcd34d',500:'#fbbf24',600:'#f59e0b' }
                    },
                    boxShadow: {
                        glow: '0 25px 60px -20px rgba(124,58,237,.45)',
                        soft: '0 10px 40px -10px rgba(15,23,42,.12)'
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css?v=20260520a" />
    <script type="importmap">
    {
        "imports": {
            "react": "https://esm.sh/react@18.3.1",
            "react-dom/client": "https://esm.sh/react-dom@18.3.1/client",
            "htm": "https://esm.sh/htm@3.1.1"
        }
    }
    </script>
</head>
<body class="min-h-full bg-slate-50 text-slate-900 font-sans antialiased">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute -top-32 -left-32 w-[42rem] h-[42rem] bg-brand-400/30 blur-3xl rounded-full"></div>
        <div class="absolute -top-20 right-0 w-[38rem] h-[38rem] bg-duck-400/30 blur-3xl rounded-full"></div>
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[50rem] h-[26rem] bg-pink-300/20 blur-3xl rounded-full"></div>
    </div>

    <header class="sticky top-0 z-30">
        <div class="backdrop-blur-xl bg-white/70 border-b border-slate-200/60">
            <div class="max-w-7xl mx-auto px-6 lg:px-10 h-16 flex items-center justify-between">
                <a href="/" class="flex items-center gap-2.5 group">
                    <span class="relative inline-flex h-9 w-9 items-center justify-center rounded-2xl bg-gradient-to-br from-brand-600 via-pink-500 to-duck-500 shadow-glow">
                        <svg viewBox="0 0 64 64" class="h-6 w-6 text-white" fill="currentColor" aria-hidden="true">
                            <path d="M44 18a8 8 0 1 0-7.6 8H40a4 4 0 0 1 4 4v2H22c-7 0-12 5-12 12 0 5 4 9 9 9h24c8 0 14-6 14-14V26c0-4-3-7-7-7h-6v-1zm-4 4a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/>
                        </svg>
                    </span>
                    <span class="font-display font-extrabold tracking-tight text-lg">
                        @brand.Name<span class="text-brand-600">@brand.Suffix</span>
                    </span>
                </a>
                <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
                    <a href="/" class="px-3 py-2 rounded-lg hover:bg-slate-100 transition">Inicio</a>
                    <a href="/Documentos" class="px-3 py-2 rounded-lg hover:bg-slate-100 transition">Mi portafolio</a>
                    <a href="/About" class="px-3 py-2 rounded-lg hover:bg-slate-100 transition">Acerca</a>
                </nav>
                <div class="flex items-center gap-2">
                    @if (isAuth)
                    {
                        <div class="hidden sm:flex items-center gap-2 pl-2 pr-1 py-1 rounded-full bg-white border border-slate-200 shadow-soft">
                            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-gradient-to-br from-brand-500 to-duck-500 text-white text-xs font-bold">@Initials(user!.DisplayName)</span>
                            <span class="text-sm font-medium pr-1">@user!.DisplayName</span>
                            <form method="post" action="/Account/Logout" class="m-0">
                                <button type="submit" class="ml-1 inline-flex items-center justify-center h-7 w-7 rounded-full hover:bg-slate-100 transition" title="Cerrar sesión" aria-label="Cerrar sesión">
                                    <svg class="h-4 w-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login?returnUrl=@Uri.EscapeDataString(path)" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-slate-900 text-white text-sm font-semibold hover:bg-brand-700 transition shadow-soft">
                            Ingresar
                            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="mt-24 border-t border-slate-200/70 bg-white/60 backdrop-blur">
        <div class="max-w-7xl mx-auto px-6 lg:px-10 py-12 grid md:grid-cols-3 gap-10">
            <div>
                <div class="flex items-center gap-2.5 mb-3">
                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-brand-600 via-pink-500 to-duck-500">
                        <svg viewBox="0 0 64 64" class="h-5 w-5 text-white" fill="currentColor"><path d="M44 18a8 8 0 1 0-7.6 8H40a4 4 0 0 1 4 4v2H22c-7 0-12 5-12 12 0 5 4 9 9 9h24c8 0 14-6 14-14V26c0-4-3-7-7-7h-6v-1z"/></svg>
                    </span>
                    <span class="font-display font-extrabold text-lg">@brand.Name<span class="text-brand-600">@brand.Suffix</span></span>
                </div>
                <p class="text-sm text-slate-600 max-w-xs">@brand.Description</p>
            </div>
            <div>
                <h4 class="font-display font-bold text-sm uppercase tracking-wider text-slate-500 mb-3">Navegación</h4>
                <ul class="space-y-2 text-sm">
                    <li><a class="text-slate-700 hover:text-brand-600" href="/">Inicio</a></li>
                    <li><a class="text-slate-700 hover:text-brand-600" href="/Documentos">Mi portafolio</a></li>
                    <li><a class="text-slate-700 hover:text-brand-600" href="/About">Acerca de @brand.FullName</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-display font-bold text-sm uppercase tracking-wider text-slate-500 mb-3">Tecnología</h4>
                <ul class="space-y-2 text-sm text-slate-600">
                    <li>Microsoft Entra External ID (CIAM)</li>
                    <li>Azure App Service · .NET 8</li>
                    <li>React 18 · Tailwind CSS</li>
                </ul>
            </div>
        </div>
        <div class="border-t border-slate-200/70">
            <div class="max-w-7xl mx-auto px-6 lg:px-10 py-5 text-xs text-slate-500 flex flex-col md:flex-row justify-between gap-2">
                <p>© @DateTime.Now.Year @brand.FullName. Demo no productivo.</p>
                <p>@brand.SupportLine</p>
            </div>
        </div>
    </footer>
</body>
</html>

