@page
@model CiamLabApp.Pages.Account.LoginModel
@inject Microsoft.Extensions.Options.IOptions<CiamLabApp.BrandingOptions> BrandOpt
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
    var brand = BrandOpt.Value;
    var ru = Uri.EscapeDataString(Model.ReturnUrl);
    var loginUrl     = $"/.auth/login/ExternalID?post_login_redirect_uri={ru}&prompt=login";
    var signupUrl    = $"/.auth/login/ExternalID?post_login_redirect_uri={ru}&prompt=create";
    var googleUrl    = $"/.auth/login/ExternalID?post_login_redirect_uri={ru}&domain_hint=google.com";
    var microsoftUrl = $"/.auth/login/ExternalID?post_login_redirect_uri={ru}&domain_hint=live.com";
    var emailUrl     = loginUrl;
}

<section class="relative min-h-[calc(100vh-4rem)] flex items-center justify-center px-6 py-16">
    <div class="relative w-full max-w-md">
        <div class="absolute -inset-4 bg-gradient-to-br from-brand-500/30 via-pink-500/30 to-duck-500/30 blur-3xl rounded-[2.5rem]"></div>

        <div class="relative rounded-[2rem] bg-white/90 backdrop-blur-xl border border-white/60 shadow-glow p-8 sm:p-10">
            <div class="flex flex-col items-center text-center">
                <span class="inline-flex h-14 w-14 items-center justify-center rounded-3xl bg-gradient-to-br from-brand-600 via-pink-500 to-duck-500 shadow-glow">
                    <svg viewBox="0 0 64 64" class="h-9 w-9 text-white" fill="currentColor"><path d="M44 18a8 8 0 1 0-7.6 8H40a4 4 0 0 1 4 4v2H22c-7 0-12 5-12 12 0 5 4 9 9 9h24c8 0 14-6 14-14V26c0-4-3-7-7-7h-6v-1zm-4 4a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/></svg>
                </span>
                <h1 class="mt-5 font-display text-3xl font-extrabold tracking-tight">Bienvenido a <span class="bg-gradient-to-r from-brand-600 to-pink-500 bg-clip-text text-transparent">@brand.FullName</span></h1>
                <p class="mt-2 text-sm text-slate-600">Accede con tu cuenta de Google, Microsoft o tu correo electrónico.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="mt-6 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm px-4 py-3">@Model.Error</div>
            }

            <a href="@loginUrl" class="group mt-8 flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-2xl bg-slate-900 text-white font-semibold shadow-glow hover:bg-brand-700 transition">
                Continuar
                <svg class="h-4 w-4 group-hover:translate-x-0.5 transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>

            <div class="mt-6 flex items-center gap-3 text-xs text-slate-400">
                <span class="flex-1 h-px bg-slate-200"></span>
                <span>protegido por Microsoft Entra</span>
                <span class="flex-1 h-px bg-slate-200"></span>
            </div>

            <div class="mt-6 grid grid-cols-3 gap-3 text-center">
                <a href="@googleUrl" class="rounded-xl border border-slate-200 bg-white py-3 hover:border-brand-500 hover:shadow-md transition" title="Continuar con Google">
                    <svg viewBox="0 0 24 24" class="h-5 w-5 mx-auto" fill="none"><path fill="#EA4335" d="M12 11v3.6h5.1c-.2 1.3-1.5 3.7-5.1 3.7-3.1 0-5.6-2.5-5.6-5.7s2.5-5.7 5.6-5.7c1.7 0 2.9.7 3.6 1.4l2.4-2.3C16.5 4.6 14.4 3.6 12 3.6c-4.7 0-8.4 3.8-8.4 8.4S7.3 20.4 12 20.4c4.8 0 8-3.4 8-8.2 0-.6 0-1-.1-1.5H12z"/></svg>
                    <div class="text-[10px] font-semibold text-slate-500 mt-1">Google</div>
                </a>
                <a href="@microsoftUrl" class="rounded-xl border border-slate-200 bg-white py-3 hover:border-brand-500 hover:shadow-md transition" title="Continuar con Microsoft">
                    <svg viewBox="0 0 24 24" class="h-5 w-5 mx-auto"><rect x="3" y="3" width="8" height="8" fill="#F25022"/><rect x="13" y="3" width="8" height="8" fill="#7FBA00"/><rect x="3" y="13" width="8" height="8" fill="#00A4EF"/><rect x="13" y="13" width="8" height="8" fill="#FFB900"/></svg>
                    <div class="text-[10px] font-semibold text-slate-500 mt-1">Microsoft</div>
                </a>
                <a href="@emailUrl" class="rounded-xl border border-slate-200 bg-white py-3 hover:border-brand-500 hover:shadow-md transition" title="Continuar con email">
                    <svg viewBox="0 0 24 24" class="h-5 w-5 mx-auto" fill="none" stroke="#7c3aed" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <div class="text-[10px] font-semibold text-slate-500 mt-1">Email</div>
                </a>
            </div>

            <p class="mt-7 text-center text-sm text-slate-600">¿No tienes cuenta? <a href="@signupUrl" class="font-semibold text-brand-700 hover:text-brand-900">Regístrate gratis</a></p>
            <p class="mt-4 text-center text-[11px] text-slate-400 leading-relaxed">Al continuar aceptas los <a class="underline hover:text-brand-600" href="#">Términos</a> y la <a class="underline hover:text-brand-600" href="#">Política de Privacidad</a> de @brand.FullName.</p>
        </div>
    </div>
</section>
