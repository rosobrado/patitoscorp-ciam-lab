@page "/Cuenta"
@model DocumentosModel
@*
    Authenticated bank dashboard: account balances + recent transactions.
    Demo data only (see Documentos.cshtml.cs). Replace with real banking
    backend when adapting the lab to production.
*@
@{
    ViewData["Title"] = "Mi cuenta";
    var user = HttpContext.Items["user"] as CiamLabApp.SiteUser;
    var isAuth = user != null;
    var accountsJson = System.Text.Json.JsonSerializer.Serialize(Model.Accounts);
    var txJson = System.Text.Json.JsonSerializer.Serialize(Model.Transactions);
}

@if (!isAuth)
{
    <section class="max-w-3xl mx-auto px-6 py-24 text-center">
        <div class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-3xl bg-gradient-to-br from-brand-600 via-pink-500 to-duck-500 shadow-glow">
            <svg class="h-8 w-8 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h1 class="mt-6 font-display text-4xl font-extrabold">Acceso restringido</h1>
        <p class="mt-4 text-slate-600 max-w-xl mx-auto leading-relaxed">Tu banca digital está protegida con autenticación moderna. Inicia sesión con Google, Microsoft o tu correo para ver tu saldo, movimientos y hacer transferencias.</p>
        <a href="/Account/Login?returnUrl=/Cuenta" class="mt-8 inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-slate-900 text-white font-semibold shadow-glow hover:bg-brand-700 transition">
            Iniciar sesión
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </section>
}
else
{
    <section class="max-w-7xl mx-auto px-6 lg:px-10 pt-12 pb-6">
        <div class="text-xs text-slate-500 mb-3"><a href="/" class="hover:text-brand-600">Inicio</a> <span class="mx-1">›</span> <span>Mi cuenta</span></div>
        <h1 class="font-display text-4xl lg:text-5xl font-extrabold tracking-tight">Hola, @user!.DisplayName 👋</h1>
        <p class="mt-2 text-slate-600">Aquí está el resumen de tu banca digital.</p>
    </section>

    <div id="dashboard"
         data-name="@user!.DisplayName"
         data-email="@user.Email"
         data-idp="@user.IdentityProvider"
         data-claims='@System.Text.Json.JsonSerializer.Serialize(user.Claims.Select(c => new { type = c.Type, value = c.Value }))'
         data-accounts='@accountsJson'
         data-tx='@txJson'>
    </div>

    <script type="module">
        import { createRoot } from 'react-dom/client';
        import { createElement, useState, useMemo } from 'react';
        import htm from 'htm';
        const html = htm.bind(createElement);

        const root = document.getElementById('dashboard');
        const data = {
            name: root.dataset.name,
            email: root.dataset.email,
            idp: root.dataset.idp,
            claims: JSON.parse(root.dataset.claims || '[]'),
            accounts: JSON.parse(root.dataset.accounts || '[]'),
            tx: JSON.parse(root.dataset.tx || '[]')
        };

        const idpLabel = (idp) => {
            if (!idp) return 'Email';
            if (idp.includes('google')) return 'Google';
            if (idp.includes('microsoft') || idp.includes('live')) return 'Microsoft';
            if (idp.includes('facebook')) return 'Facebook';
            return idp;
        };

        const fmtMoney = (amount, currency) => {
            const sign = amount < 0 ? '-' : '';
            const abs = Math.abs(amount);
            const symbol = currency === 'USD' ? '$' : '₡';
            const formatted = abs.toLocaleString('es-CR', { minimumFractionDigits: currency === 'USD' ? 2 : 0, maximumFractionDigits: 2 });
            return sign + symbol + ' ' + formatted;
        };

        function AccountCard({ acc }) {
            const symbol = acc.Currency === 'USD' ? '$' : '₡';
            const accentByCurrency = acc.Currency === 'USD' ? 'from-brand-600 to-pink-500' : 'from-emerald-500 to-teal-500';
            const balanceText = acc.Balance.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            return html`<div class="rounded-3xl bg-white/85 backdrop-blur border border-slate-200 p-6 shadow-soft">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">${acc.Name}</div>
                        <div class="font-mono text-[11px] text-slate-400 mt-1">${acc.Number}</div>
                    </div>
                    <span class=${"inline-flex items-center justify-center h-9 w-9 rounded-2xl text-white shadow-soft bg-gradient-to-br " + accentByCurrency}>
                        <span class="font-display font-extrabold text-sm">${acc.Currency}</span>
                    </span>
                </div>
                <div class="mt-4 font-display text-3xl font-extrabold tabular-nums">${symbol} ${balanceText}</div>
                <div class="mt-4 flex gap-2">
                    <button class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-slate-900 text-white text-xs font-semibold hover:bg-brand-700 transition">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                        Transferir
                    </button>
                    <button class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold hover:border-brand-400 transition">
                        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        Estado
                    </button>
                </div>
            </div>`;
        }

        function ProfileCard() {
            const [showClaims, setShowClaims] = useState(false);
            const initials = (data.name || 'U').split(' ').filter(Boolean).slice(0,2).map(p => p[0].toUpperCase()).join('');
            return html`<div class="rounded-3xl bg-white/85 backdrop-blur border border-slate-200 p-6 shadow-soft">
                <div class="flex items-center gap-4">
                    <div class="h-14 w-14 rounded-2xl bg-gradient-to-br from-brand-600 via-pink-500 to-duck-500 text-white text-xl font-display font-extrabold flex items-center justify-center shadow-glow">${initials}</div>
                    <div class="min-w-0">
                        <div class="font-display font-bold text-lg truncate">${data.name}</div>
                        <div class="text-sm text-slate-500 truncate">${data.email}</div>
                    </div>
                </div>
                <div class="mt-5 flex items-center gap-2 flex-wrap">
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Identidad verificada
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-50 text-brand-700 border border-brand-200">
                        Inicio de sesión: ${idpLabel(data.idp)}
                    </span>
                </div>
                <button onClick=${() => setShowClaims(c => !c)} class="mt-5 text-xs font-semibold text-brand-700 hover:text-brand-900 flex items-center gap-1">
                    ${showClaims ? 'Ocultar' : 'Ver'} claims del token (${data.claims.length})
                    <svg class=${"h-3.5 w-3.5 transition-transform " + (showClaims ? 'rotate-180' : '')} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                ${showClaims && html`<div class="mt-3 max-h-72 overflow-auto rounded-xl border border-slate-200 bg-slate-50/60">
                    <table class="w-full text-xs">
                        <thead class="bg-slate-100 text-slate-600 sticky top-0">
                            <tr><th class="text-left px-3 py-2 font-semibold">Tipo</th><th class="text-left px-3 py-2 font-semibold">Valor</th></tr>
                        </thead>
                        <tbody>
                            ${data.claims.map((c, i) => html`<tr key=${i} class="border-t border-slate-200">
                                <td class="px-3 py-1.5 font-mono text-[10px] text-slate-500 align-top break-all">${c.type}</td>
                                <td class="px-3 py-1.5 font-mono text-[11px] text-slate-800 align-top break-all">${c.value}</td>
                            </tr>`)}
                        </tbody>
                    </table>
                </div>`}
            </div>`;
        }

        function TxRow({ t }) {
            const positive = t.Amount >= 0;
            const amountColor = positive ? 'text-emerald-600' : 'text-slate-900';
            const iconColor = positive ? 'from-emerald-100 to-teal-100 text-emerald-700' : 'from-slate-100 to-slate-200 text-slate-600';
            const arrow = positive
                ? html`<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>`
                : html`<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="5 12 12 19 19 12"/></svg>`;
            return html`<div class="flex items-center gap-4 px-4 py-3 hover:bg-slate-50 transition">
                <div class=${"inline-flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br " + iconColor}>${arrow}</div>
                <div class="flex-1 min-w-0">
                    <div class="font-medium text-slate-900 truncate">${t.Description}</div>
                    <div class="text-xs text-slate-500">${t.Date} · ${t.Category}</div>
                </div>
                <div class=${"font-display font-extrabold tabular-nums whitespace-nowrap " + amountColor}>
                    ${(positive ? '+ ' : '') + fmtMoney(t.Amount, t.Currency)}
                </div>
            </div>`;
        }

        function Dashboard() {
            const [q, setQ] = useState('');
            const filtered = useMemo(() => {
                const s = q.trim().toLowerCase();
                return s ? data.tx.filter(t => (t.Description + ' ' + t.Category).toLowerCase().includes(s)) : data.tx;
            }, [q]);
            return html`<div class="max-w-7xl mx-auto px-6 lg:px-10">
                <div class="grid lg:grid-cols-3 gap-6">
                    ${data.accounts.map((a, i) => html`<${AccountCard} key=${i} acc=${a} />`)}
                </div>

                <div class="mt-8 grid lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 rounded-3xl bg-white/85 backdrop-blur border border-slate-200 shadow-soft overflow-hidden">
                        <div class="flex items-center justify-between gap-3 flex-wrap p-5 border-b border-slate-200">
                            <div>
                                <h2 class="font-display text-2xl font-extrabold tracking-tight">Movimientos recientes</h2>
                                <p class="text-sm text-slate-500">Tus últimas transacciones en todas tus cuentas.</p>
                            </div>
                            <div class="relative w-full sm:w-72">
                                <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                <input value=${q} onInput=${e => setQ(e.target.value)} type="text" placeholder="Buscar movimiento…"
                                    class="w-full pl-10 pr-4 py-2.5 rounded-full bg-white border border-slate-200 text-sm focus:outline-none focus:border-brand-500 focus:ring-2 focus:ring-brand-200 transition" />
                            </div>
                        </div>
                        <div class="divide-y divide-slate-100">
                            ${filtered.map((t, i) => html`<${TxRow} key=${i} t=${t} />`)}
                            ${filtered.length === 0 && html`<div class="text-center text-sm text-slate-500 py-12">Sin resultados para "${q}"</div>`}
                        </div>
                    </div>
                    <aside class="space-y-4">
                        <${ProfileCard} />
                        <div class="rounded-3xl p-6 text-white relative overflow-hidden bg-gradient-to-br from-brand-700 via-brand-600 to-pink-500 shadow-glow">
                            <div class="absolute -top-10 -right-10 h-32 w-32 rounded-full bg-duck-500/30 blur-2xl"></div>
                            <div class="relative">
                                <div class="text-xs font-semibold uppercase tracking-wider text-white/80">¿Sabías?</div>
                                <p class="mt-2 font-display text-lg font-bold leading-snug">Te autenticaste en tu banca con tu identidad de ${idpLabel(data.idp)} vía Microsoft Entra External ID.</p>
                                <p class="mt-3 text-sm text-white/85">Tu sesión está protegida con OIDC y EasyAuth en Azure App Service. Sin contraseñas almacenadas en nuestra base.</p>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>`;
        }

        createRoot(root).render(html`<${Dashboard} />`);
    </script>
}
