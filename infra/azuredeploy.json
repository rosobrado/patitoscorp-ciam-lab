{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "CIAM Lab — App Service (Linux, .NET 8) + Plan + Key Vault + System-Assigned Managed Identity. Deploy with `az deployment group create`.",
    "documentation": "https://learn.microsoft.com/azure/azure-resource-manager/templates/"
  },
  "parameters": {
    "appName": {
      "type": "string",
      "defaultValue": "[concat('extid-lab-', uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Globally unique App Service name. Default = deterministic from resource group id."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region. Defaults to the resource group's region."
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [ "F1", "B1", "B2", "S1", "P1v3" ],
      "metadata": {
        "description": "App Service Plan SKU. F1 = free (no Always On / no scaling). B1 = recommended for the lab."
      }
    },
    "dotnetVersion": {
      "type": "string",
      "defaultValue": "DOTNETCORE|8.0",
      "metadata": {
        "description": "Linux runtime stack. See: https://learn.microsoft.com/azure/app-service/configure-language-dotnet-core"
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "[concat('kv-extidlab-', uniqueString(resourceGroup().id))]",
      "maxLength": 24,
      "metadata": {
        "description": "Globally unique Key Vault name (3-24 chars, alphanumeric + hyphen)."
      }
    },
    "tenantId": {
      "type": "string",
      "defaultValue": "[subscription().tenantId]",
      "metadata": {
        "description": "Microsoft Entra tenant id used for Key Vault RBAC. Defaults to subscription tenant."
      }
    },
    "ciamTenantId": {
      "type": "string",
      "metadata": {
        "description": "Your CIAM (Entra External ID) tenant id, e.g. 938a8e7d-00ed-46bc-8109-161428d9d67c"
      }
    },
    "ciamClientId": {
      "type": "string",
      "metadata": {
        "description": "Application (client) id of the app registration in the CIAM tenant."
      }
    },
    "ciamDomain": {
      "type": "string",
      "metadata": {
          "description": "CIAM authority host, e.g. contoso.ciamlogin.com"
      }
    }
  },
  "variables": {
    "planName": "[concat('plan-', parameters('appName'))]",
    "openIdIssuer": "[concat('https://', parameters('ciamDomain'), '/', parameters('ciamTenantId'), '/v2.0')]",
    "callbackPath": "/.auth/login/ExternalID/callback"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "kind": "linux",
      "sku": {
        "name": "[parameters('skuName')]"
      },
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[parameters('dotnetVersion')]",
          "alwaysOn": false,
          "ftpsState": "FtpsOnly",
          "minTlsVersion": "1.2",
          "http20Enabled": true,
          "appSettings": [
            { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
            { "name": "WEBSITE_RUN_FROM_PACKAGE", "value": "1" },
            { "name": "ExtId__TenantId", "value": "[parameters('ciamTenantId')]" },
            { "name": "ExtId__Domain", "value": "[parameters('ciamDomain')]" },
            { "name": "ExtId__ClientId", "value": "[parameters('ciamClientId')]" },
            { "name": "ExtId__ClientSecret", "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('keyVaultName'), ';SecretName=ExtIdClientSecret)')]" }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-12-01",
      "name": "[concat(parameters('appName'), '/authsettingsV2')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ],
      "properties": {
        "platform": {
          "enabled": true,
          "runtimeVersion": "~1"
        },
        "globalValidation": {
          "requireAuthentication": false,
          "unauthenticatedClientAction": "AllowAnonymous"
        },
        "identityProviders": {
          "customOpenIdConnectProviders": {
            "ExternalID": {
              "registration": {
                "clientId": "[parameters('ciamClientId')]",
                "clientCredential": {
                  "clientSecretSettingName": "ExtId__ClientSecret"
                },
                "openIdConnectConfiguration": {
                  "wellKnownOpenIdConfiguration": "[concat(variables('openIdIssuer'), '/.well-known/openid-configuration')]"
                }
              },
              "login": {
                "nameClaimType": "preferred_username",
                "scopes": [ "openid", "profile", "email" ]
              }
            }
          }
        },
        "login": {
          "tokenStore": { "enabled": true }
        },
        "httpSettings": {
          "requireHttps": true,
          "forwardProxy": { "convention": "NoProxy" }
        }
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[parameters('tenantId')]",
        "sku": { "family": "A", "name": "standard" },
        "enableRbacAuthorization": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), parameters('appName'), 'KeyVaultSecretsUser')]",
      "scope": "[concat('Microsoft.KeyVault/vaults/', parameters('keyVaultName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "appName":     { "type": "string", "value": "[parameters('appName')]" },
    "appHostname": { "type": "string", "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName]" },
    "appUrl":      { "type": "string", "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName)]" },
    "redirectUri": { "type": "string", "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01').defaultHostName, variables('callbackPath'))]" },
    "keyVaultName": { "type": "string", "value": "[parameters('keyVaultName')]" },
    "principalId":  { "type": "string", "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-12-01', 'full').identity.principalId]" }
  }
}
